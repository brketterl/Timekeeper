{
  "name": "timekeeper",
  "version": "0.1.0",
  "private": true,
  "description": "Timekeeper time and billing application",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "backup:keygen": "node scripts/backups.js keygen",
    "backup:create": "node scripts/backups.js create",
    "backup:list": "node scripts/backups.js list",
    "backup:verify": "node scripts/backups.js verify",
    "backup:restore": "node scripts/backups.js restore",
    "backup:google-setup": "node scripts/google-backup-setup.js"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
